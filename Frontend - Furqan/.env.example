# HeatShield — Frontend Environment Configuration Template
# MIT Vishwaprayag University (MIT-VPU) | Semester III Integrated Project
# Team: TF-141 (Furqan Bagwan, Aman Shaikh, Bhavin Shankur)

# ==============================================================================
# 1. Supabase Client Configuration (Public Read-Only Anonymous Access)
# ==============================================================================
# Obtain these from your Supabase Dashboard -> Project Settings -> API.
# Note: ONLY use the public 'anon' key here.
# NEVER place SUPABASE_SERVICE_ROLE_KEY or database passwords in frontend files!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-public-anon-key

# ==============================================================================
# 2. Local Backend Fallback API Configuration
# ==============================================================================
# When Supabase is not configured or offline, the React frontend seamlessly
# falls back to the local Python Flask REST API.
VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1

# ==============================================================================
# 3. Application Metadata & Academic Disclosures
# ==============================================================================
VITE_APP_TITLE="HeatShield — Urban Heat Exposure Analysis Platform"
VITE_ACADEMIC_INSTITUTION="MIT Vishwaprayag University (MIT-VPU)"
VITE_STUDY_AREA="Solapur, Maharashtra, India"
VITE_SIMULATION_MODE=true
